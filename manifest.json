{
  "manifest_version": 3,
  "name": "Video Arrow Seek",
  "version": "1.0.1",
  "description": "Configure left/right arrow key seeking separately on popular video platforms.",
  "permissions": ["storage"],
  "icons": {
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://www.netflix.com/*",
    "https://www.youtube.com/*",
    "https://www.youtube-nocookie.com/*",
    "https://www.bilibili.com/*",
    "https://www.bilibili.tv/*",
    "https://www.disneyplus.com/*",
    "https://*.disneyplus.com/*",
    "https://www.primevideo.com/*",
    "https://*.primevideo.com/*",
    "https://www.amazon.com/*",
    "https://*.amazon.com/*",
    "https://www.twitch.tv/*",
    "https://*.twitch.tv/*",
    "https://v.qq.com/*",
    "https://*.v.qq.com/*",
    "https://youku.com/*",
    "https://*.youku.com/*",
    "https://iqiyi.com/*",
    "https://*.iqiyi.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*",
        "https://www.youtube.com/*",
        "https://www.youtube-nocookie.com/*",
        "https://www.bilibili.com/*",
        "https://www.bilibili.tv/*",
        "https://www.disneyplus.com/*",
        "https://*.disneyplus.com/*",
        "https://www.primevideo.com/*",
        "https://*.primevideo.com/*",
        "https://www.amazon.com/*",
        "https://*.amazon.com/*",
        "https://www.twitch.tv/*",
        "https://*.twitch.tv/*",
        "https://v.qq.com/*",
        "https://*.v.qq.com/*",
        "https://youku.com/*",
        "https://*.youku.com/*",
        "https://iqiyi.com/*",
        "https://*.iqiyi.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-bridge.js"],
      "matches": ["https://www.netflix.com/*"]
    }
  ],
  "action": {
    "default_title": "Video Arrow Seek",
    "default_icon": "icons/icon128.png",
    "default_popup": "popup.html"
  }
}
